# ============================================================================
# TA Candidate Screening - Environment Configuration Example
# ============================================================================
# Copy this file to .env and adjust values as needed for your environment
# Do NOT commit .env with real secrets to version control

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
APP_NAME=Talent Acquisition API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For local development: uses PostgreSQL on localhost
# For production: update with your database credentials
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/talent_acquisition

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Frontend origin allowed to access the backend API (comma-separated)
FRONTEND_CORS_ORIGIN=http://localhost:4200

# ============================================================================
# JWT & AUTHENTICATION CONFIGURATION
# ============================================================================
# IMPORTANT: Change JWT_SECRET_KEY in production to a long random string
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_DAYS=7

# ============================================================================
# ZOHO INTEGRATION CONFIGURATION
# ============================================================================
# Get these credentials from Zoho Developer Console
# Leave empty if not using Zoho integration
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_RECRUIT_BASE_URL=https://recruit.zoho.com/recruit/v2
ZOHO_CONNECTION_TIMEOUT_SECONDS=30.0
ZOHO_SYNC_MAX_RECORDS=200
# Keep false to prevent candidate data from being written back to Zoho Recruit
ZOHO_WRITE_ENABLED=false
# Encryption key for storing encrypted Zoho credentials
# IMPORTANT: Change this in production to a long random string
INTEGRATION_ENCRYPTION_KEY=

# ============================================================================
# FILE STORAGE CONFIGURATION
# ============================================================================
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=uploads
# For Azure, use STORAGE_BACKEND=azure_blob and grant the app's managed identity
# Storage Blob Data Contributor on this account/container.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=candidate-files

# Separate Ollama service
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
OLLAMA_SECTOR_MODEL=llama3.1
OLLAMA_MODELS=llama3.1,qwen3:14b
AI_PROVIDER_PRIORITY=ollama
OLLAMA_REQUEST_TIMEOUT_SECONDS=90
OLLAMA_UPLOAD_TIMEOUT_SECONDS=10
OLLAMA_BACKGROUND_CHUNK_TIMEOUT_SECONDS=180
OLLAMA_NUM_PREDICT=2048
OLLAMA_STAGED_LINE_THRESHOLD=50
OLLAMA_SECTION_CHUNK_LINES=12
OLLAMA_SECTION_OVERLAP_LINES=2
OLLAMA_SECTION_NUM_PREDICT=512
SECTOR_ENRICHMENT_ENABLED=true
SECTOR_ENRICHMENT_ON_UPLOAD=false
SECTOR_WEB_CONTEXT_ENABLED=true
SECTOR_WEB_TIMEOUT_SECONDS=10
SECTOR_MINIMUM_CONFIDENCE=0.35

# Optional one-time bootstrap. Remove these settings after the account is created.
INITIAL_ADMIN_NAME=Admin User
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ============================================================================
# PHASE 1 - RESUME ENRICHMENT CONFIGURATION
# ============================================================================
# Batch processing settings for candidate review and resume enrichment
REVIEW_BATCH_SIZE=20
RESUME_EXTRACTION_TIMEOUT_SECONDS=120.0
RESUME_EXTRACTION_RETRY_ATTEMPTS=2

# Enable/disable Zoho write operations (set to false for safety during development)
ZOHO_WRITE_ENABLED=false

# ============================================================================
# SECURITY NOTES FOR DEVELOPMENT
# ============================================================================
# ✅ DO NOT commit .env with real secrets to version control
# ✅ .env is protected in .gitignore
# ✅ For production, use a secrets manager or environment configuration service
# ✅ Example providers: AWS Secrets Manager, HashiCorp Vault, Azure Key Vault
# ✅ Rotate credentials regularly
# ✅ Use strong, unique values for all secret keys
